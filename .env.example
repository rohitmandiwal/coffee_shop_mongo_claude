# ========================================
# Coffee Shop - Environment Configuration
# ========================================
# Copy this file to .env and update values for local development
# IMPORTANT: Never commit .env to version control

# ========================================
# MongoDB Configuration
# ========================================
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-in-production
MONGO_DATABASE=coffee_shop

# ========================================
# Backend Configuration
# ========================================
NODE_ENV=production
BACKEND_PORT=3001
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRATION=24h
LOG_LEVEL=info

# ========================================
# CORS Configuration
# ========================================
# For development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ========================================
# Frontend Configuration
# ========================================
FRONTEND_PORT=3000
# Backend API URL (internal Docker network)
API_URL_BACKEND=http://backend:3001

# ========================================
# Nginx Configuration
# ========================================
# External port for accessing the application
NGINX_PORT=80
